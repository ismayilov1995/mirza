# Katibe — nümunə konfiqurasiya.
#
# Bu faylı `.env.local` adı ilə kopyalayıb doldurun. Kod məhz `.env.local`
# oxuyur (`mcp/env.ts` → `loadEnvLocal()`); `.env` adlı fayl nəzərə alınmır.
# `.env*` .gitignore-dadır — real açarlar heç vaxt repoya düşmür.
#
#   cp .env.example .env.local
#
# «TƏLƏB OLUNUR» yazılanlar olmadan panel qalxmır. Qalanları yalnız aid olduğu
# skript/ekran işlədiləndə lazımdır.

# ─────────────────────────────────────────────────────────────────────────────
# TƏLƏB OLUNUR — panelin işləməsi üçün minimum
# ─────────────────────────────────────────────────────────────────────────────

# Evolution API ilə EYNİ Postgres bazası. Katibe iki sxema görür:
#   evolution_api — Evolution-un öz cədvəlləri (yalnız OXUNUR)
#   katibe        — bu layihənin öz cədvəlləri (sql/ qovluğundan yaranır)
DATABASE_URL=postgresql://user:parol@127.0.0.1:5432/evolution?schema=katibe

# Sessiya cookie-lərinin və nəzarətçi tokenlərinin imza açarı.
# Təsadüfi 32+ bayt: openssl rand -hex 32
# Dəyişdirilsə bütün aktiv sessiyalar düşür.
SESSION_SECRET=

# Evolution API serveri (instans yaratmaq, QR almaq, qrup adlarını çəkmək üçün).
# API açarı yalnız serverdə qalır — brauzer heç vaxt görmür.
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Evolution ilə əlaqə — əlavə
# ─────────────────────────────────────────────────────────────────────────────

# Qrup adlarını sinxronlaşdıran skriptin (`npm run sync:groups`) baxdığı instans.
EVOLUTION_INSTANCE_NAME=

# Evolution-un Redis-i. `npm run harvest:lids` @lid → telefon nömrəsi
# uyğunluqlarını buradan (db 6) oxuyub `katibe.lid_number`-ə köçürür.
# Bu uyğunluqlar Redis silinsə BƏRPA OLUNMUR — səbəbi README-dədir.
EVOLUTION_REDIS_URI=redis://127.0.0.1:6379/6

# Evolution webhook-larını quran skript (`npm run ensure:webhooks`) və
# gələn webhook-ların imza yoxlaması.
KATIBE_WEBHOOK_URL=http://127.0.0.1:3000/api/webhooks/evolution
KATIBE_WEBHOOK_SECRET=

# Panelin öz ünvanı — fon skriptləri (nəzarətçi) özünə müraciət edəndə.
KATIBE_BASE_URL=http://127.0.0.1:3000

# ─────────────────────────────────────────────────────────────────────────────
# AI — PULLUDUR. Boş qoysanız AI funksiyaları söndürülür, panel işləyir.
# ─────────────────────────────────────────────────────────────────────────────

# Söhbət təhlili, satıcı faktları, nəzarətçi (Claude).
ANTHROPIC_API_KEY=

# Embedding-lər, səs transkripsiyası (Whisper), müştəri təsnifatı (default).
OPENAI_API_KEY=

# Şəkil embedding-ləri / kataloq oxşarlığı.
DEEPINFRA_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Media (S3 / MinIO) — Evolution şəkil və səsləri burada saxlayır.
# Bunlar olmasa söhbətdə mətn görünür, media görünmür.
# ─────────────────────────────────────────────────────────────────────────────
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=evolution
S3_REGION=us-east-1
S3_USE_SSL=false

# ─────────────────────────────────────────────────────────────────────────────
# MCP serveri (Claude-un panelə oxuma girişi) — istəyə bağlı
# ─────────────────────────────────────────────────────────────────────────────
KATIBE_MCP_TOKEN=
KATIBE_MCP_PORT=3333
KATIBE_MCP_PUBLIC_URL=
# Hansı istifadəçinin gözü ilə oxusun (default: bazadakı əsas hesab).
KATIBE_MCP_USER=
KATIBE_MCP_INSTANCE_ID=
# Prioritetlər faylı — repoda YOXDUR (real adlar var). Canlı yol göstərilir.
KATIBE_MCP_PRIORITIES=/var/lib/katibe/priorities.json

# ─────────────────────────────────────────────────────────────────────────────
# Digər
# ─────────────────────────────────────────────────────────────────────────────

# Nəzarətçi lenti: "main" = ana səhifədə görünür, boş = yalnız /agent-də (kölgə).
SUPERVISOR_FEED=

# Repo kökü — systemd altında işləyəndə lazım ola bilər.
KATIBE_ROOT=

# Kolleksiya şəkilləri qovluğu (repoda yoxdur, ~51 MB ikili fayl).
CATALOG_DIR=kataloq/kolleksiya

# Zakazi hesabatı: hansı qrupdan sifariş oxunsun və kimə göndərilsin.
ZAKAZI_GROUP_JID=
ZAKAZI_OWNER_NUMBER=

# İlk admin hesabı yaradılandan sonra (`npm run accounts:create`) bu sətir
# .env.local-dan SİLİNİR — parol bazada hash kimi qalır.
# DASHBOARD_PASSWORD=
