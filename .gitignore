# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# İstisna: .env.example real dəyər saxlamır, açar adlarının siyahısıdır —
# yeni maşında nəyin doldurulacağını yalnız o göstərir.
!.env.example

# vercel
.vercel

# cron output
/logs/

# typescript
*.tsbuildinfo
next-env.d.ts

# Real müştəri adları, JID-lər və telefon nömrələri var — repoda saxlanılmır.
# Canlı fayl: /var/lib/katibe/priorities.json (KATIBE_MCP_PRIORITIES).
mcp/priorities.json
.design-import/

# Kolleksiya şəkilləri — 51 MB ikili fayl, repoda yeri yoxdur.
# Canlı qovluq: kataloq/kolleksiya (CATALOG_DIR ilə dəyişdirilə bilər).
kataloq/

# Kənar agent skill-ləri (npx skills add JuliusBrussee/caveman) — 20 qovluq,
# mənbəyi bu repo deyil, versiyası skills-lock.json-dadır və `skills add` ilə
# istənilən maşında bərpa olunur. `.claude/skills` yalnız `.agents`-ə symlink-dir.
#
# `.claude/` bütövlükdə deyil, məhz `skills`: layihənin öz Claude Code ayarları
# (settings.json, hooks) nə vaxtsa yazılsa, o, repoya düşməlidir.
.agents/
.claude/skills/
skills-lock.json
